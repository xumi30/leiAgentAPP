        "filename": "stickman_simulation.py",
        "content": "#!/usr/bin/env python\n# -*- coding: utf-8 -*-\n\"\"\"\nStickman Simulation\nRules:\n1. Stickmen appear every second at random positions\n2. They move randomly\n3. When they meet, either:\n   - Older eats newer and grows larger\n   - Smaller steals from larger, making it half size\nMax 100 stickmen\n\"\"\"\nimport tkinter as tk\nimport random\nimport math\nimport time\nfrom dataclasses import dataclass\n@dataclass:\nclass Stickman:\n    id: int\n    x: float\n    y: float\n    size: float\n    birth_time: float\n    dx: float\n    dy: float\n    color: str\n\nclass Simulation:\n    def __init__(self):\n        self.root = tk.Tk()\n        self.root.title(\"Stickman Simulation\")\n        self.width = 800\n        self.height = 600\n        self.canvas = tk.Canvas(self.root, width=self.width, height=self.height, bg='white')\n        self.canvas.pack()",
        "offset": 0,
        "is_last": false
      }
    },
    {
      "id": "write_script_part2",
      "tool": "write_file_chunk",
      "depends_on": ["write_script_part1"],
      "input": {
        "filename": "stickman_simulation.py",
        "content": "\n        self.stickmen = []\n        self.max_stickmen = 100\n        self.next_id = 0\n        self.colors = ['red', 'blue', 'green', 'orange', 'purple', 'brown', 'black']\n        self.running = True\n        self.check_collision_interval = 0.1\n        \n        self.add_stickman_schedule()\n        self.schedule_collision_checking()\n    \n    def add_stickman_schedule(self):\n        if len(self.stickmen) < self.max_stickmen:\n            self.create_stickman()\n        if self.running:\n            self.root.after(1000, self.add_stickman_schedule)\n    \n    def create_stickman(self):\n        size = random.uniform(15, 25)\n        margin = size * 2\n        x = random.randint(margin, self.width - margin)\n        y = random.randint(margin, self.height - margin)\n        speed = random.uniform(0.5, 2.0)\n        angle = random.uniform(0, 2 * math.pi)\n        stickman = Stickman(\n            id=self.next_id,\n            x=x, y=y,\n            size=size,\n            birth_time=time.time(),\n            dx=speed * math.cos(angle),\n            dy=speed * math.sin(angle),\n            color=random.choice(self.colors)\n        )\n        self.stickmen.append(stickman)",
        "offset": 600,
        "is_last": false
      }
    },
    {
      "id": "write_script_part3",
      "tool": "write_file_chunk",
      "depends_on": ["write_script_part2"],
      "input": {
        "filename": "stickman_simulation.py",
        "content": "\n        self.next_id += 1\n        return stickman\n    \n    def draw_stickman(self, s):\n        x, y, sz = s.x, s.y, s.size\n        cx, cy = int(x), int(y)\n        head_r = sz // 2\n        body_h = sz\n        arm_l = sz // 3\n        leg_h = sz * 0.7\n        self.canvas.create_oval(cx-head_r, cy-head_r, cx+head_r, cy+head_r, fill=s.color, outline='black', width=1)\n        self.canvas.create_line(cx, cy+head_r, cx, cy+body_h, fill='black', width=1)\n        self.canvas.create_line(cx-arm_l, cy+head_r+arm_l, cx+arm_l, cy+head_r+arm_l, fill='black', width=1)\n        self.canvas.create_line(cx, cy+body_h, cx-leg_h, cy+leg_h, fill='black', width=1)\n        self.canvas.create_line(cx, cy+body_h, cx+leg_h, cy+leg_h, fill='black', width=1)",
        "offset": 1200,
        "is_last": false
      }
    },
    {
      "id": "write_script_part4",
      "tool": "write_file_chunk",
      "depends_on": ["write_script_part3"],
      "input": {
        "filename": "stickman_simulation.py",
        "content": "\n    def clear_canvas(self):\n        self.canvas.delete('all')\n    \n    def update_positions(self):\n        for s in self.stickmen:\n            s.x += s.dx\n            s.y += s.dy\n            if s.x <= 0 or s.x >= self.width:\n                s.dx *= -1\n                s.x = max(1, min(s.x, self.width-1))\n            if s.y <= 0 or s.y >= self.height:\n                s.dy *= -1\n                s.y = max(1, min(s.y, self.height-1))\n    \n    def check_collisions(self):\n        to_remove = set()\n        for i in range(len(self.stickmen)):\n            if i in to_remove:\n                continue\n            for j in range(i+1, len(self.stickmen)):\n                if j in to_remove:\n                    continue\n                s1, s2 = self.stickmen[i], self.stickmen[j]\n                dist = math.sqrt((s1.x-s2.x)**2 + **(s1.y-s2.y)2)",
        "offset": 1800,
        "is_last": false
      }
    },
    {
      "id": "write_script_part5",
      "tool": "write_file_chunk",
      "depends_on": ["write_script_part4"],
      "input": {
        "filename": "stickman_simulation.py",
        "content": "\n                if dist < (s1.size/2 + s2.size/2):\n                    rule = random.choice([1, 2])\n                    older = s1 if s1.birth_time < s2.birth_time else s2\n                    younger = s2 if older is s1 else s1\n                    smaller = s1 if s1.size < s2.size else s2\n                    larger = s2 if smaller is s1 else s1\n                    if rule == 1:\n                        to_remove.add(younger.id)\n                        older.size *= 1.3\n                    else:\n                        to_remove.add(smaller.id)\n                        larger.size /= 2.0\n        self.stickmen = [s for s in self.stickmen if s.id not in to_remove]",
        "offset": 2400,
