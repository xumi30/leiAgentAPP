        "filename": "matchstick_animation.py",
        "content": "#!/usr/bin/env python\n# -*- coding: utf-8 -*-\n\"\"\"火柴人动画模拟器\"\"\"\nimport tkinter as tk\nimport random\nimport math\nfrom dataclasses import dataclass, field\nfrom typing import List\n\n@dataclass\nclass Matchstick:\n    id: int\n    x: float\n    y: float\n    vx: float\n    vy: float\n    size: float = 30.0\n    birth_time: int = 0\n\nWINDOW_WIDTH = 800\nWINDOW_HEIGHT = 600\nMAX_MATCHSTICKS = 100\nSPAWN_INTERVAL_MS = 1000\nMOVE_INTERVAL_MS = 50\nMATCHSTICKS: List[Matchstick] = []\nNEXT_ID = 0\n\nThe logic for collision and interaction rules will be implemented in the following chunks.\n",
        "offset": 0,
        "is_last": false
      }
    },
    {
      "id": "step_2",
      "tool": "write_file_chunk",
      "depends_on": ["step_1"],
      "input": {
        "filename": "matchstick_animation.py",
        "content": "\ndef get_distance(m1: Matchstick, m2: Matchstick) -> float:\n    dx = m1.x - m2.x\n    dy = m1.y - m2.y\n    return math.sqrt(dx*dx + dy*dy)\n\ndef check_collisions():\n    collided = []\n    used = set()\n    for i, m1 in enumerate(MATCHSTICKS):\n        if i in used:\n            continue\n        for j, m2 in enumerate(MATCHSTICKS[i+1:], start=i+1):\n            if j in used:\n                continue\n            if get_distance(m1, m2) < m1.size + m2.size:\n                group = find_collision_group(i, used)\n                apply_random_rule(group)\n                break\n\ndef find_collision_group(start_idx, used):\n    group = [start_idx]\n    used.add(start_idx)\n    for idx in group:\n        m = MATCHSTICKS[idx]\n        for j, other in enumerate(MATCHSTICKS):\n            if j not in used and get_distance(m, other) < m.size + other.size:\n                group.append(j)\n                used.add(j)\n    return group",
        "offset": 580,
        "is_last": false
      }
    },
    {
      "id": "step_3",
      "tool": "write_file_chunk",
      "depends_on": ["step_2"],
      "input": {
        "filename": "matchstick_animation.py",
        "content": "\ndef apply_random_rule(group):\n    rule = random.choice([1, 2])\n    survivors = []\n    removed = set()\n    \n    for idx in group:\n        if idx in removed:\n            continue\n        m = MATCHSTICKS[idx]\n        candidates = [(g, MATCHSTICKS[g]) for g in group if g != idx and g not in removed]\n        if not candidates:\n            survivors.append(idx)\n            continue\n        target = random.choice(candidates)[1]\n        target_idx = [g for g in group if MATCHSTICKS[g] == target][0]\n        \n        if rule == 1 and m.birth_time < target.birth_time:\n            m.size *= 1.2\n            removed.add(target_idx)\n        elif rule == 2 and m.size < target.size:\n            target.size /= 2\n            m.size += target.size\n            removed.add(target_idx)\n        else:\n            survivors.append(idx)\n    \n    MATCHSTICKS[:] = [m for i, m in enumerate(MATCHSTICKS) if i not in removed]",
        "offset": 1160,
        "is_last": false
      }
    },
    {
      "id": "step_4",
      "tool": "write_file_chunk",
      "depends_on": ["step_3"],
      "input": {
        "filename": "matchstick_animation.py",
        "content": "\ndef spawn_matchstick():\n    global NEXT_ID\n    if len(MATCHSTICKS) >= MAX_MATCHSTICKS:\n        MATCHSTICKS.pop(0)\n    x = random.randint(30, WINDOW_WIDTH - 30)\n    y = random.randint(30, WINDOW_HEIGHT - 30)\n    vx = random.uniform(-2, 2)\n    vy = random.uniform(-2, 2)\n    m = Matchstick(id=NEXT_ID, x=x, y=y, vx=vx, vy=vy, birth_time=len(MATCHSTICKS))\n    MATCHSTICKS.append(m)\n    NEXT_ID += 1\n\ndef move_matchsticks():\n    for m in MATCHSTICKS:\n        m.x += m.vx\n        m.y += m.vy\n        if m.x < 15 or m.x > WINDOW_WIDTH - 15:\n            m.vx *= -1\n        if m.y < 15 or m.y > WINDOW_HEIGHT - 15:\n            m.vy *= -1\n        m.x = max(15, min(WINDOW_WIDTH - 15, m.x))\n        m.y = max(15, min(WINDOW_HEIGHT - 15, m.y))",
        "offset": 2070,
        "is_last": false
      }
    },
    {
      "id": "step_5",
      "tool": "write_file_chunk",
      "depends_on": ["step_4"],
      "input": {
        "filename": "matchstick_animation.py",
        "content": "\ndef draw_stick(canvas, m):\n    radius = m.size / 2\n    head_x, head_y = m.x, m.y - radius\n    canvas.create_oval(head_x-radius, head_y-radius, head_x+radius, head_y+radius, fill='#ffcc99', outline='black')\n    canvas.create_line(m.x, head_y+radius, m.x, head_y+radius+m.size/2, width=3, fill='black')\n    shoulder_y = head_y + radius + m.size/4\n    canvas.create_line(m.x-m.size/3, shoulder_y, m.x+m.size/3, shoulder_y, width=3, fill='black')\n    hip_y = head_y + radius + m.size/2\n    canvas.create_line(m.x, hip_y, m.x-m.size/4, hip_y+m.size/3, width=3, fill='black')\n    canvas.create_line(m.x, hip_y, m.x+m.size/4, hip_y+m.size/3, width=3, fill='black')\n    arm_left_y = shoulder_y + m.size/6\n    arm_right_y = shoulder_y + m.size/6\n    canvas.create_line(m.x-m.size/4, shoulder_y, m.x-m.size/2, arm_left_y, width=2, fill='black')\n    canvas.create_line(m.x+m.size/4, shoulder_y, m.x+m.size/2, arm_right_y, width=2, fill='black')\n    canvas.create_text(m.x-25, head_y-radius-5, text=str(m.id), font=('Arial', 8))",
        "offset": 2650,
        "is_last": false
      }
    },
    {
      "id": "step_6",
      "tool": "write_file_chunk",
      "depends_on": ["step_5"],
      "input": {
        "filename": "matchstick_animation.py",
        "content": "\ndef update():\n    canvas.delete('all')\n    canvas.create_text(10, 10, text=f'Matchsticks: {len(MATCHSTICKS)}/{MAX_MATCHSTICKS}', anchor='nw', fill='red')\n    for m in MATCHSTICKS:\n        draw_stick(canvas, m)\n    check_collisions()\n    move_matchsticks()\n    root.after(MOVE_INTERVAL_MS, update)\n\ndef main():\n    global root, canvas\n    root = tk.Tk()\n    root.title('火柴人动画')\n    canvas = tk.Canvas(root, width=WINDOW_WIDTH, height=WINDOW_HEIGHT, bg='white')\n    canvas.pack()\n    root.protocol('WM_DELETE_WINDOW', on_closing)\n    spawn_matchstick()\n    root.after(SPAWN_INTERVAL_MS, lambda: schedule_spawn())\n    update()\n    root.mainloop()\n\ndef schedule_spawn():\n    if len(MATCHSTICKS) < MAX_MATCHSTICKS:\n        spawn_matchstick()\n    root.after(SPAWN_INTERVAL_MS, schedule_spawn)\n\ndef on_closing():\n    root.quit()\n\nif __name__ == '__main__':\n    main()",
        "offset": 3650,
