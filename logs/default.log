        "filename": "stickman_simulation.py",
        "content": "\n    def schedule_collision_checking(self):\n        self.update_positions()\n        self.check_collisions()\n        self.clear_canvas()\n        for s in self.stickmen:\n            self.draw_stickman(s)\n        info_text = f\"Count: {len(self.stickmen)}/100\"\n        self.canvas.create_text(700, 20, text=info_text, fill='black')\n        if self.running:\n            self.root.after(int(self.check_collision_interval*1000), self.schedule_collision_checking)\n    \n    def run(self):\n        self.schedule_collision_checking()\n        self.root.protocol(\"WM_DELETE_WINDOW\", self.on_closing)\n        self.root.mainloop()\n    \n    def on_closing(self):\n        self.running = False\n        self.root.destroy()\n\nif __name__ == \"__main__\":\n    print(\"Starting Stickman Simulation...\")\n    sim = Simulation()\n    sim.run()\n",
