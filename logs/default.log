<html lang="zh">
<head>
  <meta charset="UTF-8">
  <title>变色 Hello World</title>
  <style>
    body {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
      font-size: 3em;
