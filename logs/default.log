        "content": "\ndef apply_random_rule(group):\n    rule = random.choice([1, 2])\n    survivors = []\n    removed = set()\n    \n    for idx in group:\n        if idx in removed:\n            continue\n        m = MATCHSTICKS[idx]\n        candidates = [(g, MATCHSTICKS[g]) for g in group if g != idx and g not in removed]\n        if not candidates:\n            survivors.append(idx)\n            continue\n        target = random.choice(candidates)[1]\n        target_idx = [g for g in group if MATCHSTICKS[g] == target][0]\n        \n        if rule == 1 and m.birth_time \u003c target.birth_time:\n            m.size *= 1.2\n            removed.add(target_idx)\n        elif rule == 2 and m.size \u003c target.size:\n            target.size /= 2\n            m.size += target.size\n            removed.add(target_idx)\n        else:\n            survivors.append(idx)\n    \n    MATCHSTICKS[:] = [m for i, m in enumerate(MATCHSTICKS) if i not in removed]",
