        "content": "\ndef draw_stick(canvas, m):\n    radius = m.size / 2\n    head_x, head_y = m.x, m.y - radius\n    canvas.create_oval(head_x-radius, head_y-radius, head_x+radius, head_y+radius, fill='#ffcc99', outline='black')\n    canvas.create_line(m.x, head_y+radius, m.x, head_y+radius+m.size/2, width=3, fill='black')\n    shoulder_y = head_y + radius + m.size/4\n    canvas.create_line(m.x-m.size/3, shoulder_y, m.x+m.size/3, shoulder_y, width=3, fill='black')\n    hip_y = head_y + radius + m.size/2\n    canvas.create_line(m.x, hip_y, m.x-m.size/4, hip_y+m.size/3, width=3, fill='black')\n    canvas.create_line(m.x, hip_y, m.x+m.size/4, hip_y+m.size/3, width=3, fill='black')\n    arm_left_y = shoulder_y + m.size/6\n    arm_right_y = shoulder_y + m.size/6\n    canvas.create_line(m.x-m.size/4, shoulder_y, m.x-m.size/2, arm_left_y, width=2, fill='black')\n    canvas.create_line(m.x+m.size/4, shoulder_y, m.x+m.size/2, arm_right_y, width=2, fill='black')\n    canvas.create_text(m.x-25, head_y-radius-5, text=str(m.id), font=('Arial', 8))",
